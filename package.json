{
  "name": "krakel-und-krone",
  "version": "1.0.0",
  "private": true,
  "description": "Krakel & Krone – Schreib-Motivationsspiel mit Dokumentenkamera: schöne Buchstaben werden zu süßen Wesen mit Krone.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server.js",
    "dev:api": "node tools/dev-api.ts",
    "preview": "npm run build && npm start",
    "test": "vitest run",
    "lab": "vite --open /lab.html",
    "calibrate": "node tools/calibrate.ts",
    "voice": "npx --yes vite-node tools/voice-script.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^26.6.5",
    "puppeteer-core": "^25.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "qrcode-generator": "^1.4.4"
  }
}
