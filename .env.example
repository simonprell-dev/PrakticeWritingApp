# Copy to .env for local testing (npm start and npm run dev:api read it; .env is not committed).
# On Railway set these as service variables instead.

# Postgres (local: docker compose up -d db). Without it the app runs as before, /api answers 503.
DATABASE_URL=postgres://krakel:krakel@localhost:5432/krakel
# true only for a database reached over a public TLS proxy (not for Railway's private network)
# DATABASE_SSL=true

# Admin page /admin. Without ADMIN_PASSWORD the admin area is off.
ADMIN_PASSWORD=bitte-aendern
# Signing key for the admin session (optional; otherwise derived from the password)
# ADMIN_SECRET=

# Port of node server.js
PORT=3000
